---
import ExtstatsNavbarMenu from "./ExtstatsNavbarMenu.astro";
const { items, style } = Astro.props;
---
<div class="navbar-dropdown">
{
    (async function* () {
        for await (const item of items) {
            yield item.link ?
                (<a class={`navbar-button clickable banana ${style}`} href={item.link}>{item.name}</a>) :
                (<ExtstatsNavbarMenu link={item}/>);
        }
    })()
}
</div>